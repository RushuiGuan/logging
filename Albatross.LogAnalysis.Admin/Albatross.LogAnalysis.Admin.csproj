<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Albatross.CommandLine" Version="9.0.0-rc.284" />
		<PackageReference Include="Albatross.CommandLine.Defaults" Version="9.0.0-rc.284" />
		<PackageReference Include="Albatross.CommandLine.Outputs" Version="9.0.0-rc.284" />
		<PackageReference Include="Albatross.CommandLine.Inputs" Version="9.0.0-rc.284" />
		<PackageReference Include="Albatross.Json" Version="1.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Albatross.Logging\Albatross.Logging.csproj" />
		<ProjectReference Include="..\Albatross.LogAnalysis.Database\Albatross.LogAnalysis.Database.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="serilog.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>