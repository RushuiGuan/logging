<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<AssemblyName>log-analysis</AssemblyName>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Albatross.CommandLine" Version="9.0.0-rc.284" />
		<PackageReference Include="Albatross.CommandLine.Defaults" Version="9.0.0-rc.284" />
		<PackageReference Include="Albatross.CommandLine.Outputs" Version="9.0.0-rc.284" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Albatross.LogAnalysis.Client\Albatross.LogAnalysis.Client.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>