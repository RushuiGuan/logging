{
  "program": {
    "app": "Log Analysis",
    "serviceManager": "windows"
  },
  "urls": "http://*:30500",
  "authentication": {
    "useKerberos": true
  },
  "endpoints": {
    "messaging-server": "tcp://localhost:23100"
  },
  "messaging": {
    "routerServer": {
      "logCatchUpPeriod": 60,
      "maintainConnection": false
    }
  },
  "logAnalysis": {
    "databaseProvider": "sqlserver"
  },
  "ConnectionStrings": {
    "logAnalysis": "Server=localhost;Database=LogAnalysis;Trusted_Connection=true;Encrypt=false"
  }
}