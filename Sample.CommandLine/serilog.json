{
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "MinimumLevel": {
              "Default": "Information",
              "Override": {
                "System": "Error",
                "Microsoft": "Error"
              }
            },
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "log\\log.txt",
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ssz} [{Level:w3}] ({ThreadId}) {SourceContext} {Message:lj}{NewLine}{Exception}",
                  "rollingInterval": "Day"
                }
              }
            ]
          }
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId" ]
  }
}